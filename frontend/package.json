{
  "name": "radar-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Radar (乐搭) — indie music treehole mini-program",
  "templateInfo": {
    "name": "react",
    "typescript": true,
    "css": "none"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-taro-components.js"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@tarojs/components": "^4.2.0",
    "@tarojs/plugin-framework-react": "^4.2.0",
    "@tarojs/plugin-platform-h5": "^4.2.0",
    "@tarojs/plugin-platform-weapp": "^4.2.0",
    "@tarojs/react": "^4.2.0",
    "@tarojs/runtime": "^4.2.0",
    "@tarojs/taro": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "^4.2.0",
    "@tarojs/plugin-inject": "^4.2.0",
    "@tarojs/webpack5-runner": "^4.2.0",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "babel-plugin-import": "^1.13.0",
    "babel-preset-taro": "^4.2.0",
    "postcss": "^8.4.0",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "weapp-tailwindcss": "^5.0.0",
    "webpack": "^5.90.0"
  }
}
