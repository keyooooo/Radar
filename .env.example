# Domain (used by Traefik)
DOMAIN=localhost
ENVIRONMENT=local

PROJECT_NAME="Radar"
STACK_NAME=radar

# Backend CORS
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://localhost:10086,http://127.0.0.1:10086"

# Security (CHANGE THESE in production!)
SECRET_KEY=change-me-to-a-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

# Emails (disabled by default)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SMTP_TLS=True
SMTP_PORT=587

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Docker images
DOCKER_IMAGE_BACKEND=backend

# WeChat Mini-Program (leave empty for mock mode)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Sentry (optional)
SENTRY_DSN=
